# Copy this file to .env in the repo root (next to this file) for local dev:
#   cp .env.example .env
# config.py loads .env automatically (via python-dotenv) — no shell exports
# needed. Production values are set directly on the EC2 host's environment
# instead (see README's "Deploy" section); there's no .env file in the
# Docker image, and real env vars there always win over anything in .env.

# Backend — local dev defaults work without these.
# DATA_DIR=./user_data
# API_KEY=                          # unset = no auth (local dev)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ENABLE_DOCS=1                     # show /docs in production

# Frontend — only needed when running Vite dev server separately from the API.
# VITE_API_URL=http://localhost:8000

# Plaid — unset = Plaid features stay off (manual/CSV entry keeps working).
# See README's "Connecting accounts with Plaid" section for how to get these.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox                 # sandbox while testing, production for real accounts
# PLAID_TOKEN_ENCRYPTION_KEY=       # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PLAID_WEBHOOK_URL=                # e.g. https://lucasledger.uk/api/plaid/webhook
# PLAID_SYNC_INTERVAL_MINUTES=180

# EC2 production (set in the server's environment, not here):
# DATA_DIR=/data
# API_KEY=<generate-a-long-random-string>
# PORT=8000

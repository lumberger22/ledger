# Copy to .env for local development (optional).
# Production values are set in the Railway dashboard.

# Backend — local dev defaults work without these.
# DATA_DIR=./user_data
# API_KEY=                          # unset = no auth (local dev)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ENABLE_DOCS=1                     # show /docs in production

# Frontend — only needed when running Vite dev server separately from the API.
# VITE_API_URL=http://localhost:8000

# Railway production (set in dashboard, not here):
# DATA_DIR=/data
# API_KEY=<generate-a-long-random-string>
# PORT=8000                         # set automatically by Railway

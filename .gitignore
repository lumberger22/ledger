# Python
backend/.venv/
backend/__pycache__/
backend/.pytest_cache/
backend/**/__pycache__/
*.pyc

# Node — bare pattern (no leading slash) matches node_modules/ at any
# depth, so this also covers frontend/node_modules/. The root-level
# node_modules/ (from package.json's concurrently/prettier devDependencies)
# was previously committed by mistake — 2,657 files, untracked in the same
# change that added this.
node_modules/
frontend/dist/

# User data (personal financial data - never commit this)
user_data/*.db
user_data/*.json
user_data/*.bak
!user_data/.gitkeep

# backup.sh's output — lands inside ~/ledger (the repo clone) on the EC2
# host by default, same reasoning as user_data/ above: these zips contain
# the same financial data plus encrypted Plaid tokens.
backups/

# Editor/OS
.DS_Store
.vscode/
.idea/

# Env
.env
.env.local
